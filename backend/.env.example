# Copy to .env and adjust. Every value has a safe local default.
PORT=3200
NODE_ENV=development

# PostgreSQL. Either a single URL ...
DATABASE_URL=postgres://postgres:postgres@localhost:5433/smart_attendance
# ... (docker-compose.yml in the project root starts a matching database on port 5433)

# Secrets: set long random values in production.
JWT_SECRET=change-me-to-a-long-random-string
QR_SECRET=change-me-to-another-long-random-string

# Load demo users, courses and attendance history when the database is empty.
SEED_DEMO=true
# Allow students to self-register (always creates a Student, never Admin/Faculty).
ALLOW_SELF_REGISTRATION=false
# Comma separated browser origins allowed to call the API (blank = same origin / dev proxy only).
CORS_ORIGINS=
